# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
dist/
build/

# Generated data / results (root-level only — committed test fixtures
# like tests/data/real/ must NOT be ignored: a fresh clone has to pass)
/data/
results/
reports/
*.log

# owner_gate.ps1 append-only run output. The gate creates
# evidence/owner_gate/<UTC>/ on every run; without this entry its own output
# would make the working tree dirty and the stage-0 clean-tree self-check
# would block the gate against itself. Excluding it here (a committed,
# durable rule) keeps the exclusion out of the checker as a special case.
/evidence/

# MetaTrader compiled artifacts
mql5/**/*.ex5

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Local agent/session config (never part of the repo)
.claude/
