{
  "schema_version": "1.0",
  "strategy_id": "gold2_multifactor",
  "version": 1,
  "name": "Gold #2 multi-factor reference (reconstructed)",
  "description": "GOLD_2_RECONSTRUCTED_NEW_PROVENANCE — the reconstructed Gold #2 multi-factor strategy. NOT the original Gold #2; no continuity with the historical seven-trade artifact is claimed. Entry = AND(trend gate, OR(RSI zone-escape, 20-bar breakout)); RSI escape uses the EA-canonical PROVEN_EXACT zone rule (strict zones; prev < 30 && now >= 30 for long; prev > 70 && now <= 70 for short). Signal exit on trend flip. Session filter [08:00, 16:00) flattens bars outside. Geometry: ATR(14) SL 2.0 / TP 3.0.",
  "source": {
    "type": "HUMAN",
    "reference": "mql5bot.gold2_reference.gold2_multifactor"
  },
  "hypothesis": {
    "statement": "Trend-aligned exhaustion escapes and channel breaks continue with the trend.",
    "expected_regime": "TREND_UP/TREND_DOWN",
    "expected_failure_regime": "RANGE",
    "expected_holding_bars": [
      10,
      480
    ],
    "expected_trade_frequency": "low",
    "risk_assumptions": "ATR stops; session filter concentrates risk in liquid hours."
  },
  "market": {
    "symbol": "EURUSD",
    "timeframe": "M1"
  },
  "indicators": [
    {
      "id": "ema_fast",
      "kind": "EMA",
      "period": 8,
      "applied": "close"
    },
    {
      "id": "ema_slow",
      "kind": "EMA",
      "period": 21,
      "applied": "close"
    },
    {
      "id": "rsi_main",
      "kind": "RSI",
      "period": 14,
      "applied": "close"
    },
    {
      "id": "rsi_prev",
      "kind": "RSI",
      "period": 14,
      "applied": "close",
      "shift": 1
    },
    {
      "id": "hh_prev",
      "kind": "HIGHEST",
      "period": 20,
      "applied": "high",
      "shift": 1
    },
    {
      "id": "ll_prev",
      "kind": "LOWEST",
      "period": 20,
      "applied": "low",
      "shift": 1
    }
  ],
  "entry": {
    "mode": "state",
    "long": {
      "and": [
        {
          "left": {
            "ind": "ema_fast"
          },
          "cmp": "GT",
          "right": {
            "ind": "ema_slow"
          }
        },
        {
          "or": [
            {
              "and": [
                {
                  "left": {
                    "ind": "rsi_prev"
                  },
                  "cmp": "LT",
                  "right": {
                    "const": 30
                  }
                },
                {
                  "left": {
                    "ind": "rsi_main"
                  },
                  "cmp": "GE",
                  "right": {
                    "const": 30
                  }
                }
              ]
            },
            {
              "left": {
                "price": "close"
              },
              "cmp": "GT",
              "right": {
                "ind": "hh_prev"
              }
            }
          ]
        }
      ]
    },
    "short": {
      "and": [
        {
          "left": {
            "ind": "ema_fast"
          },
          "cmp": "LT",
          "right": {
            "ind": "ema_slow"
          }
        },
        {
          "or": [
            {
              "and": [
                {
                  "left": {
                    "ind": "rsi_prev"
                  },
                  "cmp": "GT",
                  "right": {
                    "const": 70
                  }
                },
                {
                  "left": {
                    "ind": "rsi_main"
                  },
                  "cmp": "LE",
                  "right": {
                    "const": 70
                  }
                }
              ]
            },
            {
              "left": {
                "price": "close"
              },
              "cmp": "LT",
              "right": {
                "ind": "ll_prev"
              }
            }
          ]
        }
      ]
    },
    "exit_long": {
      "left": {
        "ind": "ema_fast"
      },
      "cmp": "LT",
      "right": {
        "ind": "ema_slow"
      }
    },
    "exit_short": {
      "left": {
        "ind": "ema_fast"
      },
      "cmp": "GT",
      "right": {
        "ind": "ema_slow"
      }
    }
  },
  "exit": {
    "sl": {
      "model": "atr",
      "mult": 2.0
    },
    "tp": {
      "model": "atr",
      "mult": 3.0
    }
  },
  "filters": {
    "session": {
      "start": "08:00",
      "end": "16:00"
    }
  },
  "risk": {
    "note": "Stops constrain trade geometry only; position risk is authorized solely by the Aegis Risk Engine."
  },
  "metadata": {
    "regime_tags": [
      "trend",
      "mean_reversion_trigger"
    ],
    "requires_codegen": false,
    "missing_features": []
  }
}
