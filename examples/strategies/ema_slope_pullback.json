{
  "schema_version": "1.0",
  "strategy_id": "ema_slope_pullback",
  "version": 1,
  "name": "EMA slope pullback",
  "description": "Long when price pulls back to a rising fast EMA (slope over 5 bars) while above a slow EMA.",
  "source": {
    "type": "HUMAN",
    "reference": "factory template: pullback"
  },
  "hypothesis": {
    "statement": "Pullbacks to a rising EMA in an uptrend resume.",
    "expected_regime": "TREND_UP",
    "expected_failure_regime": "TREND_DOWN"
  },
  "market": {
    "symbol": "USDJPY",
    "timeframe": "H1"
  },
  "indicators": [
    {
      "id": "ema_f",
      "kind": "EMA",
      "period": 20,
      "applied": "close"
    },
    {
      "id": "ema_s",
      "kind": "EMA",
      "period": 100,
      "applied": "close"
    }
  ],
  "entry": {
    "mode": "instant",
    "long": {
      "and": [
        {
          "rising": {
            "ind": "ema_f"
          },
          "n": 5
        },
        {
          "left": {
            "price": "close"
          },
          "cmp": "GE",
          "right": {
            "ind": "ema_f"
          }
        },
        {
          "left": {
            "price": "close"
          },
          "cmp": "LE",
          "right": {
            "mul": [
              {
                "ind": "ema_f"
              },
              {
                "const": 1.002
              }
            ]
          }
        },
        {
          "left": {
            "price": "close"
          },
          "cmp": "GT",
          "right": {
            "ind": "ema_s"
          }
        }
      ]
    }
  },
  "exit": {
    "sl": {
      "model": "atr",
      "mult": 2.0
    },
    "tp": {
      "model": "atr",
      "mult": 2.5
    },
    "trail_atr": 1.5
  },
  "filters": {
    "regime": {
      "preferred": [
        "TREND_UP"
      ],
      "forbidden": [
        "TREND_DOWN"
      ]
    }
  },
  "risk": {
    "note": "Stops constrain trade geometry only; position risk is authorized solely by the Aegis Risk Engine."
  },
  "metadata": {
    "regime_tags": [
      "trend",
      "pullback"
    ],
    "requires_codegen": false,
    "missing_features": []
  }
}
