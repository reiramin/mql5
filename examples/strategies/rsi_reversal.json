{
  "schema_version": "1.0",
  "strategy_id": "rsi_reversal_ref",
  "version": 2,
  "name": "RSI reversal (reference migration)",
  "description": "Mean reversion on zone escapes, exactly mirroring the EA's SignalEngine.EvaluateRsiReversal (Reality Gate PROVEN_EXACT closure, DECISIONS.md 2026-09-07 final): LONG when RSI escapes oversold (prev < 30 strictly, now >= 30); SHORT when RSI escapes overbought (prev > 70 strictly, now <= 70); hold the last direction through the inclusive neutral band [30, 70]; stand aside while inside an extreme zone (strict r < 30 or strict r > 70). Exact ties on 30/70 sit OUTSIDE the zones. Matches strategies.rsi_reversal.",
  "source": {
    "type": "HUMAN",
    "reference": "mql5bot.strategies.rsi_reversal"
  },
  "hypothesis": {
    "statement": "Escapes from exhaustion levels revert toward the mean.",
    "expected_regime": "RANGE",
    "expected_failure_regime": "TREND_UP/TREND_DOWN",
    "expected_holding_bars": [
      3,
      40
    ],
    "expected_trade_frequency": "medium",
    "risk_assumptions": "Tight ATR stop; failure regime is persistent trends."
  },
  "market": {
    "symbol": "EURUSD",
    "timeframe": "H1"
  },
  "indicators": [
    {
      "id": "rsi_main",
      "kind": "RSI",
      "period": 14,
      "applied": "close"
    },
    {
      "id": "rsi_prev",
      "kind": "RSI",
      "period": 14,
      "applied": "close",
      "shift": 1
    }
  ],
  "entry": {
    "mode": "state",
    "long": {
      "and": [
        {
          "left": {
            "ind": "rsi_prev"
          },
          "cmp": "LT",
          "right": {
            "const": 30
          }
        },
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "GE",
          "right": {
            "const": 30
          }
        }
      ]
    },
    "short": {
      "and": [
        {
          "left": {
            "ind": "rsi_prev"
          },
          "cmp": "GT",
          "right": {
            "const": 70
          }
        },
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "LE",
          "right": {
            "const": 70
          }
        }
      ]
    },
    "exit_long": {
      "or": [
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "LT",
          "right": {
            "const": 30
          }
        },
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "GT",
          "right": {
            "const": 70
          }
        }
      ]
    },
    "exit_short": {
      "or": [
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "LT",
          "right": {
            "const": 30
          }
        },
        {
          "left": {
            "ind": "rsi_main"
          },
          "cmp": "GT",
          "right": {
            "const": 70
          }
        }
      ]
    }
  },
  "exit": {
    "sl": {
      "model": "atr",
      "mult": 2.0
    },
    "tp": {
      "model": "atr",
      "mult": 3.0
    }
  },
  "filters": {},
  "risk": {
    "note": "Stops constrain trade geometry only; position risk is authorized solely by the Aegis Risk Engine."
  },
  "metadata": {
    "regime_tags": [
      "mean_reversion"
    ],
    "requires_codegen": false,
    "missing_features": []
  }
}
