{
  "schema_version": "1.0",
  "strategy_id": "ema_rsi_trend",
  "version": 1,
  "name": "EMA-RSI trend (NL example)",
  "description": "Buy when EMA20 crosses EMA50 upward and RSI is above 55; exit when EMA20 crosses EMA50 downward.",
  "source": {
    "type": "USER_TEXT",
    "reference": "owner description (EN)",
    "notes": "Canonical example of the two-stage interpretation flow."
  },
  "hypothesis": {
    "statement": "Momentum confirmation via RSI filters EMA whipsaw.",
    "expected_regime": "TREND_UP",
    "expected_failure_regime": "RANGE"
  },
  "claims": [],
  "market": {
    "symbol": "EURUSD",
    "timeframe": "H1"
  },
  "indicators": [
    {
      "id": "ema_f",
      "kind": "EMA",
      "period": 20,
      "applied": "close"
    },
    {
      "id": "ema_s",
      "kind": "EMA",
      "period": 50,
      "applied": "close"
    },
    {
      "id": "rsi_m",
      "kind": "RSI",
      "period": 14,
      "applied": "close"
    }
  ],
  "entry": {
    "mode": "state",
    "long": {
      "and": [
        {
          "cross": "ABOVE",
          "a": {
            "ind": "ema_f"
          },
          "b": {
            "ind": "ema_s"
          }
        },
        {
          "left": {
            "ind": "rsi_m"
          },
          "cmp": "GT",
          "right": {
            "param": "rsi_min"
          }
        }
      ]
    },
    "short": {
      "cross": "BELOW",
      "a": {
        "ind": "ema_f"
      },
      "b": {
        "ind": "ema_s"
      }
    }
  },
  "exit": {
    "sl": {
      "model": "atr",
      "mult": 1.5
    },
    "tp": {
      "model": "atr",
      "mult": 3.0
    }
  },
  "filters": {},
  "risk": {
    "note": "Stops constrain trade geometry only; position risk is authorized solely by the Aegis Risk Engine."
  },
  "params": {
    "rsi_min": {
      "type": "number",
      "default": 55.0,
      "min": 50.0,
      "max": 70.0,
      "step": 1.0
    }
  },
  "metadata": {
    "regime_tags": [
      "trend",
      "momentum"
    ],
    "requires_codegen": false,
    "missing_features": []
  }
}
