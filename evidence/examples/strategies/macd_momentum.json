{
  "schema_version": "1.0",
  "strategy_id": "macd_momentum_ref",
  "version": 1,
  "name": "MACD momentum (reference migration)",
  "description": "Momentum: long while the MACD line is above its signal line, short while below (state semantics).",
  "source": {
    "type": "HUMAN",
    "reference": "mql5bot.strategies.macd_momentum"
  },
  "hypothesis": {
    "statement": "MACD/signal alignment persists short-term.",
    "expected_regime": "TREND",
    "expected_failure_regime": "RANGE",
    "expected_holding_bars": [
      5,
      80
    ],
    "expected_trade_frequency": "medium",
    "risk_assumptions": "Standard ATR stop."
  },
  "market": {
    "symbol": "EURUSD",
    "timeframe": "H1"
  },
  "indicators": [
    {
      "id": "macd_main",
      "kind": "MACD",
      "fast": 12,
      "slow": 26,
      "signal": 9
    }
  ],
  "entry": {
    "mode": "state",
    "long": {
      "left": {
        "ind": "macd_main__line"
      },
      "cmp": "GT",
      "right": {
        "ind": "macd_main__signal"
      }
    },
    "short": {
      "left": {
        "ind": "macd_main__line"
      },
      "cmp": "LT",
      "right": {
        "ind": "macd_main__signal"
      }
    }
  },
  "exit": {
    "sl": {
      "model": "atr",
      "mult": 2.5
    },
    "tp": {
      "model": "atr",
      "mult": 4.0
    }
  },
  "filters": {},
  "risk": {
    "note": "Stops constrain trade geometry only; position risk is authorized solely by the Aegis Risk Engine."
  },
  "metadata": {
    "regime_tags": [
      "momentum",
      "trend"
    ],
    "requires_codegen": false,
    "missing_features": []
  }
}
